# Seeded library, generated from test/fixtures by scripts/seed-library.mjs.
# Never commit a second copy of the fixture media.
/media/

# Plugin DLLs dropped in by hand from the dotnet build output.
/plugins/SubtitleSync/*
!/plugins/SubtitleSync/.gitkeep

# The File Transformation plugin, downloaded into place by
# scripts/file-transformation.mjs. Third-party binaries, pinned by checksum at
# install time - never committed.
/plugins/FileTransformation/*
!/plugins/FileTransformation/.gitkeep
