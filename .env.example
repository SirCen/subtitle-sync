# Copy to `.env.local` (git-ignored) and edit, or set these in your host's
# environment settings. Values are read by `next build`, not at runtime.

# Feature flag: show the Jellyfin plugin page at /plugin and its nav link.
#
# Only the exact string "1" turns it on. Unset, empty, "0", "true" or anything
# else leaves it OFF, in which case /plugin returns 404 and the nav link is not
# rendered.
#
# NOTE: NEXT_PUBLIC_ variables are inlined into the client bundle at build time.
# Changing this needs a rebuild, and the gated page is hidden, not secret.
NEXT_PUBLIC_FEATURE_PLUGIN_PAGE=0
