{
  "name": "subtitle-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:bundle": "node jellyfin-plugin/web/build.mjs",
    "plugin:bundle:dev": "node jellyfin-plugin/web/build.mjs --dev",
    "plugin:bundle:watch": "node jellyfin-plugin/web/build.mjs --watch",
    "jf:up": "node jellyfin-plugin/docker/scripts/setup.mjs",
    "jf:down": "node jellyfin-plugin/docker/scripts/teardown.mjs",
    "jf:logs": "docker compose -f jellyfin-plugin/docker/docker-compose.yml logs -f jellyfin",
    "jf:ft": "node jellyfin-plugin/docker/scripts/file-transformation.mjs install",
    "jf:ft:uninstall": "node jellyfin-plugin/docker/scripts/file-transformation.mjs uninstall",
    "jf:ft:status": "node jellyfin-plugin/docker/scripts/file-transformation.mjs status",
    "jf:e2e": "playwright test",
    "jf:screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@echogarden/fvad-wasm": "^0.2.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fft.js": "^4.0.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
